  {
    "name": "ingest_ocean_colour",
    "description": "Ingest Ocean colour from 1997 to present derived from satellite observations.\n\n        Daily chlorophyll-a in mg m-3 at the nearest grid cell. CDS credentials and\n        dataset licence acceptance required. Recent dates may not yet be published.\n        Query the resulting ocean_colour dataset using pipeline_query.\n        ",
    "inputSchema": {
      "properties": {
        "year": {
          "default": 2026,
          "title": "Year",
          "type": "integer"
        },
        "month": {
          "default": 3,
          "title": "Month",
          "type": "integer"
        },
        "day": {
          "default": 31,
          "title": "Day",
          "type": "integer"
        },
        "latitude": {
          "default": 51.675,
          "title": "Latitude",
          "type": "number"
        },
        "longitude": {
          "default": -9.625,
          "title": "Longitude",
          "type": "number"
        },
        "force": {
          "default": false,
          "title": "Force",
          "type": "boolean"
        }
      },
      "title": "ingest_ocean_colourArguments",
      "type": "object"
    }
  },
